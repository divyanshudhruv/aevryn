# Supabase project URL + publishable (anon) key — Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Postgres connection string — direct DB connection used by Drizzle, the
# workflow tests, and the auth-callback profile write-through.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Derives the AES-256-GCM key that encrypts user secrets (provider keys,
# Anakin/Mem0 keys) at rest. Rotating forces users to re-enter their keys.
VAULT_KEY=<64-hex-or-longer-random-string>

# Standalone HMAC secret that signs tool-approval responses (AI SDK
# experimental_toolApprovalSecret). Kept separate from VAULT_KEY so rotating
# either never invalidates the other. Must be >= 32 chars.
APPROVAL_SECRET=<64-hex-or-longer-random-string>
