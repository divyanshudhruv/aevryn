{
	"name": "aevryn",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6.0.3",
			"@types/node": "^26.2.0",
			"lucide-react": "^1.27.0",
			"next": "^16.3.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.7",
			"@trpc/server": "^11.18.0",
			"@trpc/client": "^11.18.0",
			"@supabase/supabase-js": "^2.116.0",
			"@supabase/ssr": "^0.12.7",
			"@tailwindcss/postcss": "^4.3.3",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"inngest:dev": "bunx inngest-cli dev -u http://localhost:3001/api/inngest",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"db:push": "turbo run db:push -F @aevryn/db --",
		"db:studio": "turbo run db:studio -F @aevryn/db --",
		"db:generate": "turbo run db:generate -F @aevryn/db --",
		"db:migrate": "turbo run db:migrate -F @aevryn/db --",
		"deploy:setup": "vercel link",
		"dev:vercel": "vercel dev -L",
		"env:preview": "tsx scripts/sync-vercel-env.ts preview",
		"env:production": "tsx scripts/sync-vercel-env.ts production",
		"deploy": "vercel deploy",
		"deploy:prod": "vercel deploy --prod",
		"deploy:check": "vercel deploy --dry",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@aevryn/env": "workspace:*",
		"@ai-sdk/groq": "^4.0.37",
		"ai": "^7.0.93",
		"dotenv": "catalog:",
		"inngest": "^4.20.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@aevryn/config": "workspace:*",
		"@biomejs/biome": "^2.5.11",
		"@types/node": "catalog:",
		"inngest-cli": "^1.44.0",
		"lefthook": "^2.1.12",
		"tsx": "^4.23.1",
		"turbo": "^2.10.12",
		"typescript": "catalog:",
		"vercel": "^58.1.0",
		"vitest": "^5.0.0"
	},
	"trustedDependencies": [
		"inngest-cli"
	],
	"packageManager": "bun@1.3.9"
}
