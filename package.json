{
	"name": "aevryn",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6.0.3",
			"@types/node": "^26.2.0",
			"lucide-react": "^1.27.0",
			"next": "^16.3.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.7",
			"@supabase/supabase-js": "^2.116.0",
			"@supabase/ssr": "^0.12.7",
			"@tailwindcss/postcss": "^4.3.3",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"db:push": "turbo run db:push -F @aevryn/db --",
		"db:studio": "turbo run db:studio -F @aevryn/db --",
		"db:generate": "turbo run db:generate -F @aevryn/db --",
		"db:migrate": "turbo run db:migrate -F @aevryn/db --",
		"deploy:setup": "vercel link",
		"dev:vercel": "vercel dev -L",
		"deploy": "vercel deploy",
		"deploy:prod": "vercel deploy --prod",
		"deploy:check": "vercel deploy --dry",
		"check": "biome check --write ."
	},
	"devDependencies": {
		"@aevryn/config": "workspace:*",
		"@biomejs/biome": "^2.5.11",
		"@types/node": "catalog:",
		"lefthook": "^2.1.12",
		"turbo": "^2.10.12",
		"typescript": "catalog:",
		"vercel": "^58.1.0",
		"vitest": "^5.0.0"
	},
	"packageManager": "bun@1.3.9",
	"overrides": {
		"@ai-sdk/provider-utils": "5.0.40",
		"@ai-sdk/provider": "4.0.14",
		"drizzle-orm": "0.45.2"
	}
}
